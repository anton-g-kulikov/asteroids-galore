rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The same pattern as CALLSIGN_PATTERN in src/cloud/callsign.ts.
    function validCallsign(value) {
      return value is string && value.matches('^[A-Z]{3,9} [A-Z]{3,9} [0-9]{2}$');
    }

    function wholeNumber(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    // How a run ended. There are 7 missions (LAST_LEVEL in src/game/tuning.ts).
    // A `won` run went home through the wormhole of mission 7; `final` is the
    // parsecs flown in mission 7, and 0 for a run that never got there.
    function validEnd(outcome, level, final) {
      return outcome in ['won', 'over']
        && wholeNumber(level, 1, 7)
        && (outcome != 'won' || level == 7)
        && wholeNumber(final, 0, 1000000)
        && (level == 7 || final == 0);
    }

    // One document per finished run. Written once by the player; never changed.
    // Anyone holding a run's ID can read it (that is what a share link is), but
    // runs cannot be listed.
    match /runs/{runId} {
      allow get: if true;
      allow create: if signedInAs(request.resource.data.userId) && validRun(request.resource.data);

      function validRun(run) {
        return run.keys().hasOnly(['userId', 'callsign', 'createdAt', 'appVersion', 'outcome', 'score', 'distance', 'level', 'finalDistance', 'saved', 'lost', 'missed', 'durationSeconds', 'ship', 'ships', 'fpsAvg', 'fpsLow', 'audioUnderruns', 'audioUnderrunMs', 'audioFirstUnderrun', 'audioStops'])
          && run.keys().hasAll(['userId', 'callsign', 'createdAt', 'appVersion', 'outcome', 'score', 'distance', 'level', 'finalDistance', 'saved', 'lost', 'missed', 'durationSeconds', 'ship', 'ships'])
          && run.createdAt == request.time
          && validCallsign(run.callsign)
          && run.appVersion is string && run.appVersion.size() <= 20
          && wholeNumber(run.distance, 0, 1000000)
          && validEnd(run.outcome, run.level, run.finalDistance)
          && run.finalDistance <= run.distance
          // The ship each mission was flown in (there are 3: SHIPS in
          // src/game/tuning.ts), one per mission reached, and the one the run
          // ended in. Every run starts in ship 1.
          && run.ships is list && run.ships.size() == run.level
          && run.ships.hasOnly([1, 2, 3])
          && run.ships[0] == 1
          && run.ship == run.ships[run.level - 1]
          && wholeNumber(run.saved, 0, 1000)
          && wholeNumber(run.lost, 0, 1000)
          && (run.outcome != 'won' || run.lost == 0)
          // The score is the missions added up, each its own parsecs times its
          // own crew saved, less what was missed. The run's totals cannot give
          // the exact figure, only its ceiling: all the parsecs times all the crew.
          && wholeNumber(run.score, 0, 1000000000)
          && run.score <= run.distance * run.saved
          && wholeNumber(run.missed, 0, 10000)
          && run.durationSeconds is number && run.durationSeconds >= 0 && run.durationSeconds <= 86400
          // The frame rate the run was flown at (src/fps/runFrames.ts): both or neither, so a
          // client from before them still saves.
          && (run.keys().hasAll(['fpsAvg', 'fpsLow'])
              ? wholeNumber(run.fpsAvg, 0, 1000) && wholeNumber(run.fpsLow, 0, 1000)
              : !run.keys().hasAny(['fpsAvg', 'fpsLow']))
          // How the sound held up (src/audio/runSound.ts): each one optional, since a browser may not count gaps.
          && (!run.keys().hasAny(['audioUnderruns']) || wholeNumber(run.audioUnderruns, 0, 1000000))
          && (!run.keys().hasAny(['audioUnderrunMs']) || wholeNumber(run.audioUnderrunMs, 0, 86400000))
          && (!run.keys().hasAny(['audioFirstUnderrun']) || wholeNumber(run.audioFirstUnderrun, 0, 86400))
          && (!run.keys().hasAny(['audioStops']) || wholeNumber(run.audioStops, 0, 10000));
      }
    }

    // One document per story flight (src/story/flightRecord.ts), for the owner's data: how the screen
    // and the sound held up in story mode. Written once by the player; never read, changed or listed
    // by the game. Story progress itself stays on the device.
    match /flights/{flightId} {
      allow create: if signedInAs(request.resource.data.userId) && validFlight(request.resource.data);

      function validFlight(f) {
        return f.keys().hasOnly(['userId', 'callsign', 'createdAt', 'appVersion', 'moon', 'boat', 'isReturn', 'picked', 'destroyed', 'laps', 'dev', 'durationSeconds',
                                 'fpsAvg', 'fpsLow', 'audioUnderruns', 'audioUnderrunMs', 'audioFirstUnderrun', 'audioStops'])
          && f.keys().hasAll(['userId', 'callsign', 'createdAt', 'appVersion', 'moon', 'boat', 'isReturn', 'picked', 'destroyed', 'laps', 'dev', 'durationSeconds'])
          && f.createdAt == request.time
          && validCallsign(f.callsign)
          && f.appVersion is string && f.appVersion.size() <= 20
          && wholeNumber(f.moon, 0, 6)
          && wholeNumber(f.boat, 1, 3)
          && f.isReturn is bool && f.destroyed is bool && f.dev is bool
          && wholeNumber(f.picked, 0, 1000)
          && wholeNumber(f.laps, 0, 1000)
          && f.durationSeconds is number && f.durationSeconds >= 0 && f.durationSeconds <= 86400
          && (f.keys().hasAll(['fpsAvg', 'fpsLow'])
              ? wholeNumber(f.fpsAvg, 0, 1000) && wholeNumber(f.fpsLow, 0, 1000)
              : !f.keys().hasAny(['fpsAvg', 'fpsLow']))
          && (!f.keys().hasAny(['audioUnderruns']) || wholeNumber(f.audioUnderruns, 0, 1000000))
          && (!f.keys().hasAny(['audioUnderrunMs']) || wholeNumber(f.audioUnderrunMs, 0, 86400000))
          && (!f.keys().hasAny(['audioFirstUnderrun']) || wholeNumber(f.audioFirstUnderrun, 0, 86400))
          && (!f.keys().hasAny(['audioStops']) || wholeNumber(f.audioStops, 0, 10000));
      }
    }

    // A player's leaderboard entry: callsign, best score and how that run
    // ended, with the ship it ended in (0 when that was not recorded). Public to read, since the board is a query over this collection.
    // The best only ever goes up. An entry written under earlier scoring has no
    // `best6` (it has `best6`, `best4`, `best3`, `best`, `bestScore`, or older fields): it counts as 0, is
    // not on the board, and is replaced whole by the player's first entry of
    // this kind.
    match /users/{userId} {
      allow read: if true;
      allow create: if signedInAs(userId) && validEntry(request.resource.data);
      allow update: if signedInAs(userId) && validEntry(request.resource.data)
        && request.resource.data.best6 >= resource.data.get('best6', 0);

      function validEntry(user) {
        return user.keys().hasOnly(['callsign', 'best6', 'bestOutcome', 'bestLevel', 'bestFinal', 'bestShip', 'updatedAt'])
          && user.keys().hasAll(['callsign', 'best6', 'bestOutcome', 'bestLevel', 'bestFinal', 'bestShip', 'updatedAt'])
          && validCallsign(user.callsign)
          && wholeNumber(user.best6, 0, 1000000000)
          && validEnd(user.bestOutcome, user.bestLevel, user.bestFinal)
          && wholeNumber(user.bestShip, 0, 3)
          && user.updatedAt == request.time;
      }
    }
  }
}
